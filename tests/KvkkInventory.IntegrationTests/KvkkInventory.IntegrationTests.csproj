<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.Oracle" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\KvkkInventory.Core\KvkkInventory.Core.csproj" />
    <ProjectReference Include="..\..\src\KvkkInventory.Synthetic\KvkkInventory.Synthetic.csproj" />
    <ProjectReference Include="..\..\src\KvkkInventory.Postgres\KvkkInventory.Postgres.csproj" />
    <ProjectReference Include="..\..\src\KvkkInventory.Oracle\KvkkInventory.Oracle.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The exact account-creation scripts docker compose mounts, so least privilege is tested, not assumed. -->
    <None Include="..\..\deploy\postgres\init\01-roles.sh" Link="db-init\postgres-01-roles.sh" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\deploy\oracle\init\01-users.sh" Link="db-init\oracle-01-users.sh" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
  </ItemGroup>

</Project>
